{
  "name": "miam",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "db:create": "wrangler d1 create miam-db",
    "db:migrate": "wrangler d1 execute miam-db --local --file=./schema.sql && wrangler d1 execute miam-db --local --file=./migrations/0001_meal_workspace.sql",
    "db:seed": "wrangler d1 execute miam-db --file=./seed.sql",
    "typecheck": "wrangler types && react-router typegen && tsc --noEmit",
    "test:smoke": "node tests/mobile.cjs",
    "test": "node --test tests/*.test.mjs",
    "setup:local": "node scripts/setup-local.mjs"
  },
  "dependencies": {
    "@react-router/node": "^8.0.0",
    "isbot": "^5.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@playwright/test": "1.65.1",
    "@react-router/dev": "^8.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "wrangler": "^4.0.0"
  },
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24 <25"
  }
}

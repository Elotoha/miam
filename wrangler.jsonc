{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miam",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-11-16",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "miam-db",
      "database_id": "e48bac93-5927-49e9-854d-8e8bb12240bf"
    }
  ],
  "ai": {
    "binding": "AI",
    "remote": true
  }
}

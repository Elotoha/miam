{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["@cloudflare/vite-plugin/client"],
    "paths": {
      "~/*": ["./app/*"]
    }
  },
  "include": ["app/**/*", "workers/**/*", ".react-router/types/**/*"],
  "exclude": ["node_modules"]
}
